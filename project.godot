; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="try1"
run/main_scene="uid://cwlsh4gnus3nt"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"MAIN_GIRL_MIA": "res://addons/dialogic/Example Assets/sound-effects/MAIN_GIRL_MIA.dch",
"RADIO_GIRL": "res://addons/dialogic/Example Assets/sound-effects/RADIO_GIRL.dch",
"character1": "res://dialogic/character1.dch",
