}
layout/style_directory={
"": "res://dialogic/New_File.tres",
"AAAA": "res://addons/dialogic/Example Assets/sound-effects/AAAA.tres",
"LLLL": "res://addons/dialogic/Example Assets/sound-effects/LLLL.tres",
